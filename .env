# Copy this file to ".env" and fill in your values

PORT=3000

# Used to sign login cookies. Type any long random text (at least 16 characters) and keep it private.
SESSION_SECRET=change-this-to-a-long-random-text
MONGO_URI=mongodb://127.0.0.1:27017/sunny_kitchen

# Optional: enables the real AI suggester and chatbot.
# Without a key, both features still work using a simple built-in fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
